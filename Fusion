<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FUSION — Beyond Ordinary</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<!-- LEAFLET MAP -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

<style>
:root {
    --bg: #080808;
    --surface: #111;
    --surface2: #181818;
    --white: #f5f5f5;
    --gray: #999;
    --border: #292929;
    --accent: #F5F1E8;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html { scroll-behavior: smooth; }

body {
    font-family: 'Inter', sans-serif;
    background: var(--bg);
    color: var(--white);
}

button, input, select, textarea { font: inherit; }
button { cursor: pointer; }
a { text-decoration: none; color: inherit; }

/* ANNOUNCEMENT */

.announcement {
    background: var(--accent);
    color: #080808;
    text-align: center;
    padding: 10px;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 2px;
}

/* NAVBAR */

header {
    height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 7%;
    background: #F5F1E8;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(15px);
}

.logo img {
    height: 45px;
    width: auto;
    object-fit: contain;
    display: block;
}

nav {
    display: flex;
    gap: 30px;
}

nav a {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    color: #000;
    transition: .2s;
}

nav a:hover { color: #777; }

.header-actions {
    display: flex;
    align-items: center;
    gap: 20px;
}

.icon-btn {
    background: none;
    border: 0;
    color: #080808;
    font-size: 23px;
    position: relative;
}

.cart-count {
    position: absolute;
    top: -8px;
    right: -10px;
    background: var(--accent);
    color: black;
    border-radius: 50%;
    width: 18px;
    height: 18px;
    font-size: 10px;
    font-weight: 900;
    display: grid;
    place-items: center;
}

/* HERO */

.hero {
    min-height: 650px;
    background:
        linear-gradient(90deg, rgba(0,0,0,.9), rgba(0,0,0,.25)),
        url("Logo.png") center/cover;
    display: flex;
    align-items: center;
    padding: 8%;
}

.hero-content { max-width: 650px; }

.eyebrow {
    color: var(--accent);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 5px;
    margin-bottom: 25px;
}

.hero h1 {
    font-size: clamp(55px, 9vw, 110px);
    font-weight: 900;
    line-height: .9;
    letter-spacing: -6px;
}

.hero p {
    color: #fff;
    margin: 28px 0 35px;
    font-size: 12px;
    letter-spacing: 2px;
    line-height: 2;
}

.primary-btn {
    display: inline-block;
    padding: 17px 30px;
    background: var(--accent);
    color: #080808;
    border: 1px solid var(--accent);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 2px;
    transition: .3s;
}

.primary-btn:hover {
    background: transparent;
    color: var(--accent);
    transform: translateY(-3px);
}

/* CATEGORIES */

.categories {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    padding: 65px 7%;
}

.category {
    height: 280px;
    position: relative;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
}

.category img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(.7);
    transition: .5s;
}

.category:hover img {
    transform: scale(1.07);
    filter: brightness(.9);
}

.category h3 {
    position: absolute;
    bottom: 22px;
    left: 22px;
    font-size: 20px;
    font-weight: 900;
    letter-spacing: 2px;
}

/* SHOP */

.shop { padding: 75px 7%; }

.section-heading {
    text-align: center;
    margin-bottom: 45px;
}

.section-heading h2 {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 900;
    letter-spacing: 3px;
}

.section-heading p {
    color: var(--gray);
    margin-top: 12px;
    font-size: 11px;
    letter-spacing: 2px;
}

.shop-tools {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    gap: 15px;
}

.filters {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
}

.filter-btn {
    border: 1px solid var(--border);
    background: var(--surface);
    color: white;
    padding: 11px 17px;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
    transition: .2s;
}

.filter-btn.active,
.filter-btn:hover {
    background: var(--accent);
    color: black;
    border-color: var(--accent);
}

.search {
    width: 220px;
    padding: 12px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: white;
    outline: none;
    font-size: 11px;
}

.search:focus { border-color: var(--accent); }
.search::placeholder { color: #777; }

.products {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
}

.product {
    cursor: pointer;
    min-width: 0;
}

.product-image {
    height: 330px;
    overflow: hidden;
    background: var(--surface2);
    position: relative;
    border: 1px solid var(--border);
}

.product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: .5s;
}

.product:hover .product-image img { transform: scale(1.06); }

.product-tag {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--accent);
    color: black;
    padding: 7px 10px;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 1px;
}

.product-info { padding: 15px 0; }

.product-info h3 {
    font-size: 12px;
    margin-bottom: 9px;
}

.product-info p {
    color: var(--accent);
    font-size: 12px;
    font-weight: 800;
}

.add-btn {
    width: 100%;
    background: white;
    color: black;
    border: 1px solid white;
    padding: 13px;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 1px;
    margin-top: 13px;
    transition: .3s;
}

.add-btn:hover {
    background: var(--accent);
    border-color: var(--accent);
}

.no-products {
    grid-column: 1/-1;
    text-align: center;
    padding: 50px;
    color: var(--gray);
}

/* BANNER */

.banner {
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    text-align: center;
    padding: 100px 20px;
}

.banner h2 {
    font-size: clamp(35px, 6vw, 70px);
    font-weight: 900;
    letter-spacing: 3px;
}

.banner p {
    margin: 20px 0 30px;
    color: #999;
    font-size: 11px;
    letter-spacing: 2px;
}

/* ABOUT */

.about {
    padding: 90px 15%;
    text-align: center;
}

.about h2 {
    font-size: 32px;
    letter-spacing: 3px;
    margin-bottom: 20px;
}

.about p {
    color: #999;
    font-size: 12px;
    line-height: 2.2;
}

/* NEWSLETTER */

.newsletter {
    padding: 65px 20px;
    text-align: center;
    background: #111;
}

.newsletter h2 { font-size: 25px; }

.newsletter p {
    color: #999;
    font-size: 11px;
    margin: 12px 0 22px;
}

.newsletter form {
    display: flex;
    max-width: 420px;
    margin: auto;
}

.newsletter input {
    flex: 1;
    min-width: 0;
    padding: 14px;
    border: 1px solid #333;
    background: #080808;
    color: white;
    outline: none;
}

.newsletter button {
    background: var(--accent);
    color: black;
    border: none;
    padding: 0 22px;
    font-size: 10px;
    font-weight: 900;
}

/* FOOTER */

footer {
    background: #030303;
    border-top: 1px solid var(--border);
    padding: 55px 7% 25px;
}

.footer-top {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 30px;
}

.footer-logo {
    font-size: 29px;
    font-weight: 900;
    letter-spacing: 5px;
}

.footer-links {
    display: flex;
    gap: 25px;
    flex-wrap: wrap;
    font-size: 10px;
    color: #999;
}

.footer-links a:hover { color: var(--accent); }

.copyright {
    border-top: 1px solid #292929;
    margin-top: 40px;
    padding-top: 20px;
    color: #777;
    font-size: 9px;
    text-align: center;
}

/* CART */

.overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.75);
    z-index: 40;
}

.overlay.show { display: block; }

.drawer {
    position: fixed;
    right: -450px;
    top: 0;
    height: 100%;
    width: min(420px, 100%);
    background: #101010;
    border-left: 1px solid var(--border);
    z-index: 41;
    padding: 25px;
    transition: .3s;
    overflow-y: auto;
}

.drawer.open { right: 0; }

.drawer-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding-bottom: 20px;
}

.drawer-head h2 {
    font-size: 17px;
    letter-spacing: 2px;
}

.close-btn {
    background: none;
    border: 0;
    color: white;
    font-size: 27px;
}

.cart-items { margin-top: 20px; }

.cart-item {
    display: flex;
    gap: 15px;
    padding: 15px 0;
    border-bottom: 1px solid var(--border);
}

.cart-item img {
    width: 75px;
    height: 90px;
    object-fit: cover;
}

.cart-item h4 {
    font-size: 11px;
    margin: 5px 0;
}

.cart-item p {
    font-size: 11px;
    color: var(--accent);
}

.quantity {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-top: 12px;
}

.quantity button {
    background: #292929;
    color: white;
    border: 0;
    width: 25px;
    height: 25px;
}

.remove-btn {
    margin-top: 8px;
    border: 0;
    background: none;
    color: #999;
    text-decoration: underline;
    font-size: 10px;
}

.cart-total {
    margin-top: 25px;
    border-top: 1px solid var(--border);
    padding-top: 20px;
}

.total-line {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
    font-weight: 800;
    font-size: 13px;
}

.checkout-btn {
    width: 100%;
    padding: 17px;
    background: var(--accent);
    color: black;
    border: 1px solid var(--accent);
    font-weight: 900;
    letter-spacing: 1px;
    font-size: 10px;
    transition: .2s;
}

.checkout-btn:hover {
    background: transparent;
    color: var(--accent);
}

.checkout-btn:disabled {
    opacity: .4;
    cursor: not-allowed;
}

.empty {
    text-align: center;
    padding: 50px 10px;
    color: #888;
    font-size: 12px;
}

/* CHECKOUT */

.modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.85);
    z-index: 60;
    align-items: center;
    justify-content: center;
    padding: 15px;
}

.modal.show { display: flex; }

.modal-content {
    background: #111;
    border: 1px solid #333;
    width: min(520px, 100%);
    max-height: 90vh;
    overflow-y: auto;
    padding: 30px;
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
}

.modal-header h2 {
    font-size: 19px;
    letter-spacing: 2px;
}

.form-group { margin-bottom: 17px; }

.form-group label {
    display: block;
    font-size: 9px;
    font-weight: 900;
    margin-bottom: 8px;
    letter-spacing: 1px;
}

.form-group input,
.form-group textarea,
.form-group select {
    width: 100%;
    padding: 13px;
    border: 1px solid #333;
    background: #080808;
    color: white;
    outline: none;
    font-size: 12px;
}

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
    border-color: var(--accent);
}

.form-group input::placeholder,
.form-group textarea::placeholder { color: #777; }

.form-group select option {
    background: #111;
    color: white;
}

.form-group textarea {
    resize: vertical;
    min-height: 80px;
}

.phone-hint {
    display: block;
    color: #999;
    font-size: 10px;
    margin-top: 7px;
}

.checkout-summary {
    background: #1b1b1b;
    padding: 15px;
    margin-bottom: 20px;
    font-size: 11px;
    line-height: 2;
    color: #ddd;
}

.payment-note {
    font-size: 10px;
    color: #999;
    line-height: 1.7;
    margin: 15px 0;
}

/* DELIVERY MAP */

.location-section {
    margin-bottom: 20px;
}

.location-section label {
    display: block;
    font-size: 9px;
    font-weight: 900;
    margin-bottom: 10px;
    letter-spacing: 1px;
}

.location-btn {
    width: 100%;
    padding: 12px;
    margin-bottom: 12px;
    background: var(--accent);
    color: #080808;
    border: none;
    font-size: 11px;
    font-weight: 900;
}

.location-btn:disabled {
    opacity: .6;
    cursor: wait;
}

#map {
    width: 100%;
    height: 280px;
    border-radius: 8px;
    border: 1px solid #333;
    z-index: 1;
}

.location-status {
    color: #999;
    font-size: 10px;
    margin-top: 10px;
    line-height: 1.6;
}

/* TOAST */

.toast {
    position: fixed;
    bottom: 25px;
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    background: var(--accent);
    color: black;
    padding: 14px 22px;
    z-index: 100;
    font-size: 11px;
    font-weight: 900;
    transition: .3s;
    text-align: center;
    width: max-content;
    max-width: 90%;
}

.toast.show { transform: translateX(-50%) translateY(0); }

/* MOBILE */

@media(max-width: 900px) {
    .products { grid-template-columns: repeat(2, 1fr); }
    .product-image { height: 300px; }
}

@media(max-width: 600px) {
    header {
        height: 70px;
        padding: 0 5%;
    }

    nav { display: none; }

    .hero {
        min-height: 530px;
        padding: 8% 6%;
    }

    .hero h1 { letter-spacing: -3px; }

    .categories {
        padding: 30px 5%;
        grid-template-columns: 1fr;
    }

    .category { height: 220px; }

    .shop { padding: 50px 5%; }

    .shop-tools {
        align-items: stretch;
        flex-direction: column;
    }

    .search { width: 100%; }

    .products { gap: 15px 10px; }
    .product-image { height: 220px; }
    .product-info h3 { font-size: 10px; }
    .add-btn { padding: 11px 5px; }

    .about { padding: 65px 8%; }
    .footer-links { gap: 15px; }
    .modal-content { padding: 20px; }
    #map { height: 250px; }
}

@media(max-width: 360px) {
    .product-image { height: 180px; }
    .section-heading h2 { font-size: 24px; }
}
</style>
</head>

<body>

<header>
    <a class="logo" href="#">
        <img src="Name.png" alt="FUSION Logo">
    </a>

    <nav>
        <a href="#">HOME</a>
        <a href="#shop">SHOP</a>
        <a href="#categories">CATEGORIES</a>
        <a href="#about">ABOUT</a>
    </nav>

    <div class="header-actions">
        <button class="icon-btn" onclick="openCart()" aria-label="Shopping cart">
            ♧ <span class="cart-count" id="cartCount">0</span>
        </button>
    </div>
</header>

<!-- HERO -->

<section class="hero">
    <div class="hero-content">
        <div class="eyebrow">FUSION — COLLECTION 2026</div>
        <h1>BEYOND<br>ORDINARY.</h1>
        <p>
            YOUR STYLE. YOUR RULES.<br>
            DISCOVER A DIFFERENT WAY TO EXPRESS YOURSELF.
        </p>
        <a href="#shop" class="primary-btn">EXPLORE COLLECTION ↗</a>
    </div>
</section>

<!-- CATEGORIES -->

<section class="categories" id="categories">

    <a href="#shop" class="category" onclick="setCategory('Clothing')">
        <img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?w=700" alt="Clothing">
        <h3>CLOTHING ↗</h3>
    </a>

    <a href="#shop" class="category" onclick="setCategory('Accessories')">
        <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=700" alt="Accessories">
        <h3>ACCESSORIES ↗</h3>
    </a>

    <a href="#shop" class="category" onclick="setCategory('Lifestyle')">
        <img src="https://images.unsplash.com/photo-1490312278390-ab64016e0aa9?w=700" alt="Lifestyle">
        <h3>LIFESTYLE ↗</h3>
    </a>

</section>

<!-- SHOP -->

<section class="shop" id="shop">

    <div class="section-heading">
        <h2>THE COLLECTION</h2>
        <p>STAND OUT. STAY DIFFERENT.</p>
    </div>

    <div class="shop-tools">
        <div class="filters">
            <button class="filter-btn active" onclick="setCategory('All',this)">ALL</button>
            <button class="filter-btn" onclick="setCategory('Clothing',this)">CLOTHING</button>
            <button class="filter-btn" onclick="setCategory('Accessories',this)">ACCESSORIES</button>
            <button class="filter-btn" onclick="setCategory('Lifestyle',this)">LIFESTYLE</button>
        </div>

        <input type="search" class="search" id="search"
            placeholder="Search products..." oninput="renderProducts()">
    </div>

    <div class="products" id="products"></div>

</section>

<!-- BANNER -->

<section class="banner">
    <h2>LESS, BUT BETTER.</h2>
    <p>QUALITY OVER QUANTITY. STYLE WITHOUT LIMITS.</p>
    <a href="#shop" class="primary-btn">SHOP NOW ↗</a>
</section>

<!-- ABOUT -->

<section class="about" id="about">
    <h2>THE FUSION IDENTITY.</h2>
    <p>
        FUSION is more than a store. It's a lifestyle.
        We believe in simplicity, quality, and individuality.
        Every detail matters. Every choice says something.
        Discover your style. Define your identity.
    </p>
</section>

<!-- NEWSLETTER -->

<section class="newsletter">
    <h2>STAY IN THE LOOP.</h2>
    <p>GET UPDATES ABOUT NEW COLLECTIONS AND EXCLUSIVE DROPS.</p>

    <form onsubmit="subscribe(event)">
        <input type="email" placeholder="Your email address" required>
        <button type="submit">JOIN ↗</button>
    </form>
</section>

<!-- FOOTER -->

<footer>
    <div class="footer-top">
        <div class="footer-logo">FUSION.</div>

        <div class="footer-links">
            <a href="#">INSTAGRAM</a>
            <a href="#">FACEBOOK</a>
            <a href="#about">ABOUT US</a>
            <a href="#shop">SHOP</a>
        </div>
    </div>

    <div class="copyright">
        © 2026 FUSION. ALL RIGHTS RESERVED.
    </div>
</footer>

<!-- CART -->

<div class="overlay" id="overlay" onclick="closeCart()"></div>

<aside class="drawer" id="drawer">
    <div class="drawer-head">
        <h2>YOUR BAG</h2>
        <button class="close-btn" onclick="closeCart()">×</button>
    </div>

    <div class="cart-items" id="cartItems"></div>
    <div class="cart-total" id="cartTotal"></div>
</aside>

<!-- CHECKOUT -->

<div class="modal" id="checkoutModal">
    <div class="modal-content">

        <div class="modal-header">
            <h2>CHECKOUT</h2>
            <button class="close-btn" onclick="closeCheckout()">×</button>
        </div>

        <div class="checkout-summary" id="checkoutSummary"></div>

        <form id="checkoutForm" onsubmit="placeOrder(event)">

            <div class="form-group">
                <label>FULL NAME</label>
                <input name="name" type="text" required placeholder="Your full name">
            </div>

            <div class="form-group">
                <label>PHONE NUMBER</label>
                <input
                    name="phone"
                    id="phone"
                    type="tel"
                    required
                    inputmode="numeric"
                    maxlength="11"
                    minlength="11"
                    pattern="01[0125][0-9]{8}"
                    placeholder="01012345678"
                    title="Enter a valid Egyptian mobile number (11 digits)"
                >
                <span class="phone-hint">Egyptian mobile number — 11 digits</span>
            </div>

            <div class="form-group">
                <label>GOVERNORATE</label>
                <select name="governorate" required>
                    <option value="">Choose your governorate</option>
                    <option>Cairo</option>
                    <option>Giza</option>
                    <option>Alexandria</option>
                    <option>Qalyubia</option>
                    <option>Sharqia</option>
                    <option>Gharbia</option>
                    <option>Other</option>
                </select>
            </div>

            <div class="form-group">
                <label>FULL ADDRESS</label>
                <textarea name="address" required
                    placeholder="Street, building, apartment..."></textarea>
            </div>

            <!-- DELIVERY LOCATION MAP -->

            <div class="location-section">

                <label>DELIVERY LOCATION *</label>

                <button type="button" class="location-btn" id="locateMe">
                    📍 USE MY CURRENT LOCATION
                </button>

                <div id="map"></div>

                <p class="location-status" id="locationStatus">
                    Click anywhere on the map to select your delivery location.
                </p>

                <input type="hidden" name="latitude" id="latitude">
                <input type="hidden" name="longitude" id="longitude">

            </div>

            <div class="form-group">
                <label>PAYMENT METHOD</label>
                <select name="payment" required>
                    <option value="Cash on Delivery">Cash on Delivery</option>
                    <option value="Online Payment (not connected)">
                        Online Payment (not connected)
                    </option>
                </select>
            </div>

            <div class="form-group">
                <label>ORDER NOTES (OPTIONAL)</label>
                <textarea name="notes" placeholder="Any special instructions..."></textarea>
            </div>

            <p class="payment-note">
                This is a demo checkout. No payment is collected and
                no order is sent to a store server until backend integration.
            </p>

            <button type="submit" class="checkout-btn">
                CONFIRM DEMO ORDER
            </button>

        </form>
    </div>
</div>

<div class="toast" id="toast"></div>

<!-- LEAFLET SCRIPT -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>

// PRODUCT DATABASE

const products = [
    {
        id: 1,
        name: "WESTWOOD FOX Winter Thermal Gloves Windproof Running Gloves Touch Screen Warm Anti Slip Silicone Cycling Gloves for Men Women,Elastic Cuff for Driving, Ski Running Football Sports",
        price: 450,
        category: "Clothing",
        tag: "BEST SELLER",
        image: "712iToZlutL._AC_SL1500_.jpg"
    },
    {
        id: 2,
        name: "Premium Black Hoodie",
        price: 850,
        category: "Clothing",
        tag: "NEW",
        image: "61EkpXRxZHL._AC_SX569_.jpg"
    },
    {
        id: 3,
        name: "Classic Street Jacket",
        price: 1200,
        category: "Clothing",
        tag: "LIMITED",
        image: "https://images.unsplash.com/photo-1551028719-00167b16eac5?w=600"
    },
    {
        id: 4,
        name: "Minimal Wrist Watch",
        price: 950,
        category: "Accessories",
        tag: "NEW",
        image: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600"
    },
    {
        id: 5,
        name: "Classic Sunglasses",
        price: 550,
        category: "Accessories",
        tag: "POPULAR",
        image: "https://images.unsplash.com/photo-1511499767150-a48a237f0083?w=600"
    },
    {
        id: 6,
        name: "Premium Backpack",
        price: 1100,
        category: "Accessories",
        tag: "NEW",
        image: "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=600"
    },
    {
        id: 7,
        name: "Minimal Coffee Mug",
        price: 250,
        category: "Lifestyle",
        tag: "ESSENTIAL",
        image: "https://images.unsplash.com/photo-1514228742587-6b1558fcca3d?w=600"
    },
    {
        id: 8,
        name: "Modern Room Lamp",
        price: 750,
        category: "Lifestyle",
        tag: "NEW",
        image: "https://images.unsplash.com/photo-1507473885765-e6ed057f782c?w=600"
    }
];

let cart = [];
let currentCategory = "All";

// FORMAT PRICE

function formatPrice(price) {
    return "EGP " + price.toLocaleString("en-US");
}

// RENDER PRODUCTS

function renderProducts() {

    const container = document.getElementById("products");
    const search = document.getElementById("search").value.toLowerCase();

    const filtered = products.filter(product => {

        const categoryMatch =
            currentCategory === "All" ||
            product.category === currentCategory;

        const searchMatch =
            product.name.toLowerCase().includes(search);

        return categoryMatch && searchMatch;
    });

    container.innerHTML = "";

    if (filtered.length === 0) {
        container.innerHTML = '<div class="no-products">NO PRODUCTS FOUND.</div>';
        return;
    }

    filtered.forEach(product => {

        container.innerHTML += `
            <div class="product">
                <div class="product-image">
                    <img src="${product.image}" alt="${product.name}" loading="lazy">
                    <span class="product-tag">${product.tag}</span>
                </div>

                <div class="product-info">
                    <h3>${product.name}</h3>
                    <p>${formatPrice(product.price)}</p>

                    <button class="add-btn" onclick="addToCart(${product.id})">
                        ADD TO BAG +
                    </button>
                </div>
            </div>
        `;
    });
}

// CATEGORY FILTER

function setCategory(category, button) {

    currentCategory = category;

    document.querySelectorAll(".filter-btn").forEach(btn => {
        btn.classList.remove("active");
    });

    if (button) {
        button.classList.add("active");
    } else {
        document.querySelectorAll(".filter-btn").forEach(btn => {
            if (btn.textContent.trim() === category.toUpperCase()) {
                btn.classList.add("active");
            }
        });
    }

    renderProducts();
}

// ADD TO CART

function addToCart(id) {

    const product = products.find(p => p.id === id);
    const existing = cart.find(item => item.id === id);

    if (existing) {
        existing.quantity++;
    } else {
        cart.push({...product, quantity: 1});
    }

    updateCart();
    showToast("ADDED TO YOUR BAG!");
}

// CART CONTROLS

function updateQuantity(id, change) {

    const item = cart.find(p => p.id === id);

    if (!item) return;

    item.quantity += change;

    if (item.quantity <= 0) {
        cart = cart.filter(p => p.id !== id);
    }

    updateCart();
}

function removeItem(id) {
    cart = cart.filter(p => p.id !== id);
    updateCart();
}

// UPDATE CART

function updateCart() {

    const count = cart.reduce((sum, item) => sum + item.quantity, 0);

    const total = cart.reduce(
        (sum, item) => sum + item.price * item.quantity, 0
    );

    document.getElementById("cartCount").textContent = count;

    const container = document.getElementById("cartItems");

    if (cart.length === 0) {

        container.innerHTML = '<div class="empty">YOUR BAG IS EMPTY.</div>';

    } else {

        container.innerHTML = cart.map(item => `
            <div class="cart-item">
                <img src="${item.image}" alt="${item.name}">

                <div>
                    <h4>${item.name}</h4>
                    <p>${formatPrice(item.price)}</p>

                    <div class="quantity">
                        <button onclick="updateQuantity(${item.id},-1)">−</button>
                        <span>${item.quantity}</span>
                        <button onclick="updateQuantity(${item.id},1)">+</button>
                    </div>

                    <button class="remove-btn" onclick="removeItem(${item.id})">
                        REMOVE
                    </button>
                </div>
            </div>
        `).join("");
    }

    document.getElementById("cartTotal").innerHTML = `
        <div class="total-line">
            <span>SUBTOTAL</span>
            <span>${formatPrice(total)}</span>
        </div>

        <button class="checkout-btn"
            onclick="openCheckout()"
            ${cart.length === 0 ? "disabled" : ""}>
            PROCEED TO CHECKOUT ↗
        </button>
    `;
}

// OPEN / CLOSE CART

function openCart() {
    document.getElementById("drawer").classList.add("open");
    document.getElementById("overlay").classList.add("show");
}

function closeCart() {
    document.getElementById("drawer").classList.remove("open");
    document.getElementById("overlay").classList.remove("show");
}

// DELIVERY MAP

let map = null;
let marker = null;

function initCheckoutMap() {

    if (!map) {

        map = L.map("map").setView([30.0444, 31.2357], 11);

        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        map.on("click", function(event) {
            selectDeliveryLocation(event.latlng.lat, event.latlng.lng);
        });
    }

    setTimeout(() => {
        map.invalidateSize();
    }, 250);
}

function selectDeliveryLocation(lat, lng) {

    if (!map) return;

    if (marker) {
        marker.setLatLng([lat, lng]);
    } else {

        marker = L.marker([lat, lng], {
            draggable: true
        }).addTo(map);

        marker.on("dragend", function() {
            const position = marker.getLatLng();
            selectDeliveryLocation(position.lat, position.lng);
        });
    }

    document.getElementById("latitude").value = lat;
    document.getElementById("longitude").value = lng;

    document.getElementById("locationStatus").textContent =
        "Location selected: " +
        lat.toFixed(6) + ", " +
        lng.toFixed(6);
}

// CURRENT LOCATION BUTTON

document.getElementById("locateMe").addEventListener("click", function() {

    if (!navigator.geolocation) {
        showToast("LOCATION NOT SUPPORTED!");
        return;
    }

    const button = this;
    button.disabled = true;
    button.textContent = "GETTING YOUR LOCATION...";

    navigator.geolocation.getCurrentPosition(

        function(position) {

            const lat = position.coords.latitude;
            const lng = position.coords.longitude;

            map.setView([lat, lng], 16);
            selectDeliveryLocation(lat, lng);

            button.disabled = false;
            button.textContent = "📍 USE MY CURRENT LOCATION";
        },

        function() {

            showToast("LOCATION ACCESS DENIED!");

            button.disabled = false;
            button.textContent = "📍 USE MY CURRENT LOCATION";
        },

        {
            enableHighAccuracy: true,
            timeout: 10000
        }
    );
});

// CHECKOUT

function openCheckout() {

    if (cart.length === 0) return;

    const total = cart.reduce(
        (sum, item) => sum + item.price * item.quantity, 0
    );

    document.getElementById("checkoutSummary").innerHTML = `
        <strong>ORDER SUMMARY</strong><br>
        ${cart.map(item =>
            `${item.name} × ${item.quantity} — ${formatPrice(item.price * item.quantity)}`
        ).join("<br>")}
        <hr style="margin:10px 0;border-color:#333">
        <strong>TOTAL: ${formatPrice(total)}</strong>
    `;

    closeCart();

    document.getElementById("checkoutModal").classList.add("show");

    initCheckoutMap();
}

function closeCheckout() {
    document.getElementById("checkoutModal").classList.remove("show");
}

// EGYPTIAN PHONE VALIDATION

const phoneInput = document.getElementById("phone");

phoneInput.addEventListener("input", function() {
    this.value = this.value.replace(/\D/g, "").slice(0, 11);
});

function isValidEgyptianPhone(phone) {
    return /^01[0125][0-9]{8}$/.test(phone);
}

// PLACE DEMO ORDER

function placeOrder(event) {

    event.preventDefault();

    if (cart.length === 0) {
        showToast("YOUR BAG IS EMPTY!");
        return;
    }

    const form = new FormData(event.target);
    const phone = String(form.get("phone") || "").trim();

    if (!isValidEgyptianPhone(phone)) {
        showToast("ENTER A VALID 11-DIGIT EGYPTIAN NUMBER!");
        phoneInput.focus();
        return;
    }

    const latitude = document.getElementById("latitude").value;
    const longitude = document.getElementById("longitude").value;

    if (!latitude || !longitude) {
        showToast("PLEASE SELECT YOUR DELIVERY LOCATION!");
        return;
    }

    const customer = {
        name: form.get("name"),
        phone: phone,
        governorate: form.get("governorate"),
        address: form.get("address"),
        latitude: latitude,
        longitude: longitude,
        payment: form.get("payment"),
        notes: form.get("notes")
    };

    const order = {
        orderNumber: "FUS-" + Date.now(),
        customer: customer,
        items: cart.map(item => ({
            id: item.id,
            name: item.name,
            quantity: item.quantity,
            price: item.price
        })),
        total: cart.reduce(
            (sum, item) => sum + item.price * item.quantity, 0
        )
    };

    // DEMO ONLY - SAVED IN THIS BROWSER

    localStorage.setItem(
        "fusion_last_demo_order",
        JSON.stringify(order)
    );

    alert(
        "ORDER CREATED!\n\n" +
        "Order: " + order.orderNumber +
        "\nTotal: " + formatPrice(order.total) +
        "\nLocation: " + latitude + ", " + longitude +
        "\n\nThis is a demo. Your order was not sent to a store server."
    );

    cart = [];
    updateCart();
    closeCheckout();
    event.target.reset();

    // Reset selected map location
    document.getElementById("latitude").value = "";
    document.getElementById("longitude").value = "";
    document.getElementById("locationStatus").textContent =
        "Click anywhere on the map to select your delivery location.";

    if (marker && map) {
        map.removeLayer(marker);
        marker = null;
    }
}

// NEWSLETTER

function subscribe(event) {
    event.preventDefault();
    showToast("THANKS FOR JOINING FUSION!");
    event.target.reset();
}

// TOAST

function showToast(message) {

    const toast = document.getElementById("toast");

    toast.textContent = message;
    toast.classList.add("show");

    setTimeout(() => {
        toast.classList.remove("show");
    }, 2500);
}

// CLOSE MODAL WITH ESCAPE

document.addEventListener("keydown", function(event) {

    if (event.key === "Escape") {
        closeCart();
        closeCheckout();
    }
});

// INITIALIZE

renderProducts();
updateCart();

</script>

</body>
</html>

